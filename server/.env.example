# Copy to .env for local development. Values below are the local defaults;
# production values are set in the Render dashboard, not here.

DATABASE_URL='postgresql://user:password@localhost:5432/express_prisma'
PORT=8000

# Signs the session cookie. Anything guessable lets a visitor forge a session
# and claim host on any room. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET='change-me'

# Where the browser app is served from: the CORS allow-list, and where the
# Spotify callback returns the user. Production: https://spotifyparty.netlify.app
FRONTEND_URL='http://127.0.0.1:3000'

# Must match a Redirect URI registered in the Spotify dashboard byte-for-byte.
# Production: https://spotifyparty.netlify.app/callback  (proxied to Render by
# Netlify, so the session cookie stays first-party)
REDIRECT_URI='http://127.0.0.1:3000/callback'

CLIENT_ID=''
CLIENT_SECRET=''
SCOPES='user-read-playback-state user-modify-playback-state user-read-currently-playing'

# Set to production on Render. Enables secure/SameSite=None cookies and the
# trust-proxy setting Render's TLS termination requires.
# NODE_ENV=production
